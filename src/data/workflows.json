  {
    "id": "86ef29b4-0b81-4470-b9a1-e85ec7f144db",
    "name": "Track Active Visitor",
    "parameters": [
      {
        "key": "session_id",
        "name": "session_id",
        "type": "string",
        "required": false,
        "description": "معرف جلسة الزائر الفريد"
      },
      {
        "key": "current_page",
        "name": "current_page",
        "type": "string",
        "required": false,
        "description": "اسم أو مسار الصفحة الحالية"
      }
    ],
    "actions": {
      "__CLEAN_EXPIRED__": {
        "id": "__CLEAN_EXPIRED__",
        "name": "Clean Expired Visitor Sessions",
        "next": "__UPDATE_EXISTING_SESSION__",
        "type": "table-delete",
        "filters": {
          "link": "$and",
          "conditions": [
            {
              "field": "last_seen_at",
              "value": {
                "code": "return new Date(Date.now() - 10 * 60 * 1000).toISOString();",
                "__wwtype": "js"
              },
              "operator": "$lt"
            }
          ]
        },
        "tableName": "site_visitors",
        "deleteMode": "by-filters",
        "returnData": false,
        "__wwdescription": "حذف جلسات الزوار غير النشطة التي مضى عليها أكثر من 10 دقائق"
      },
      "__CHECK_IF_UPDATED__": {
        "id": "__CHECK_IF_UPDATED__",
        "name": "Check If Session Was Updated",
        "next": "__SELECT_ACTIVE_VISITORS__",
        "type": "if",
        "value": {
          "code": "const updated = context.workflow['__UPDATE_EXISTING_SESSION__']?.result || [];\nconst hasSessionId = Boolean(String(context.parameters['session_id'] || '').trim());\nreturn updated.length === 0 && hasSessionId;",
          "__wwtype": "js"
        },
        "branches": [
          {
            "id": "__INSERT_NEW_SESSION__",
            "value": true
          },
          {
            "id": null,
            "value": false
          }
        ],
        "__wwdescription": "التحقق مما إذا كانت الجلسة موجودة مسبقاً أم تحتاج لإدخال جديد"
      },
      "__INSERT_NEW_SESSION__": {
        "id": "__INSERT_NEW_SESSION__",
        "data": {
          "session_id": {
            "code": "return String(context.parameters['session_id']).trim();",
            "__wwtype": "js"
          },
          "current_page": {
            "code": "return context.parameters['current_page'] || 'home';",
            "__wwtype": "js"
          },
          "last_seen_at": {
            "code": "return new Date().toISOString();",
            "__wwtype": "js"
          }
        },
        "mode": "single",
        "name": "Insert New Visitor Session",
        "next": null,
        "type": "table-insert",
        "upsert": false,
        "columns": [
          "session_id",
          "current_page",
          "last_seen_at"
        ],
        "tableName": "site_visitors",
        "returnData": true,
        "__wwdescription": "تسجيل جلسة زائر جديدة في جدول الزوار النشطين"
      },
      "__RETURN_ACTIVE_COUNT__": {
        "id": "__RETURN_ACTIVE_COUNT__",
        "args": {
          "body": {
            "code": "const rows = context.workflow['__SELECT_ACTIVE_VISITORS__']?.result?.data || [];\nconst total = context.workflow['__SELECT_ACTIVE_VISITORS__']?.result?.metadata?.total ?? rows.length;\nreturn { activeCount: total, visitors: rows };",
            "__wwtype": "js"
          },
          "status": 200,
          "contentType": "application/json"
        },
        "name": "Return Active Visitors Count",
        "next": null,
        "type": "return-response",
        "__wwdescription": "إرجاع العدد الحقيقي للزوار المتواجدين حالياً"
      },
      "__SELECT_ACTIVE_VISITORS__": {
        "id": "__SELECT_ACTIVE_VISITORS__",
        "name": "Select Active Visitors Count",
        "next": "__RETURN_ACTIVE_COUNT__",
        "sort": [
          {
            "key": "last_seen_at",
            "direction": "DESC"
          }
        ],
        "type": "table-select",
        "count": true,
        "columns": {
          "id": true,
          "session_id": true,
          "current_page": true,
          "last_seen_at": true
        },
        "tableName": "site_visitors",
        "formulaColumns": {},
        "__wwdescription": "جلب العدد الفعلي للزوار المتواجدين حالياً في الموقع"
      },
      "__UPDATE_EXISTING_SESSION__": {
        "id": "__UPDATE_EXISTING_SESSION__",
        "data": {
          "current_page": {
            "code": "return context.parameters['current_page'] || 'home';",
            "__wwtype": "js"
          },
          "last_seen_at": {
            "code": "return new Date().toISOString();",
            "__wwtype": "js"
          }
        },
        "name": "Update Existing Visitor Session",
        "next": "__CHECK_IF_UPDATED__",
        "type": "table-update",
        "columns": [
          "current_page",
          "last_seen_at"
        ],
        "filters": {
          "link": "$and",
          "conditions": [
            {
              "field": "session_id",
              "value": {
                "code": "return String(context.parameters['session_id'] || 'anon');",
                "__wwtype": "js"
              },
              "operator": "$eq"
            }
          ]
        },
        "tableName": "site_visitors",
        "returnData": true,
        "updateMode": "by-filters",
        "__wwdescription": "تحديث وقت آخر ظهور للزائر الحالي إذا كانت جلسته مسجلة"
      }
    },
    "firstAction": "__CLEAN_EXPIRED__",
    "firstErrorAction": null,
    "meta": {
      "path": "/api/track-visitor",
      "method": "POST",
      "security": {
        "accessRule": "public"
      }
    },
    "trigger": "ww-api"
  },
  {
    "id": "4137e2a7-2918-4739-91a9-0645a24807c4",
    "name": "Save Redirect URL Setting",
    "parameters": [
      {
        "key": "redirect_url",
        "name": "redirect_url",
        "type": "string",
        "required": false,
        "description": "رابط التوجيه الجديد بعد الشراء"
      }
    ],
    "actions": {
      "__INSERT_SETTING__": {
        "id": "__INSERT_SETTING__",
        "data": {
          "setting_key": "redirect_url",
          "redirect_url": {
            "code": "const raw = String(context.parameters['redirect_url'] || '').trim();\nif (!raw) return '';\nif (/^https?:\\/\\//i.test(raw) || raw.startsWith('/')) return raw;\nreturn 'https://' + raw;",
            "__wwtype": "js"
          }
        },
        "mode": "single",
        "name": "Insert Redirect URL Setting",
        "next": null,
        "type": "table-insert",
        "upsert": false,
        "columns": [
          "setting_key",
          "redirect_url"
        ],
        "tableName": "site_settings",
        "returnData": true,
        "__wwdescription": "إدراج صف إعداد رابط التوجيه لأول مرة"
      },
      "__UPDATE_SETTING__": {
        "id": "__UPDATE_SETTING__",
        "data": {
          "redirect_url": {
            "code": "const raw = String(context.parameters['redirect_url'] || '').trim();\nif (!raw) return '';\nif (/^https?:\\/\\//i.test(raw) || raw.startsWith('/')) return raw;\nreturn 'https://' + raw;",
            "__wwtype": "js"
          }
        },
        "name": "Update Redirect URL Setting",
        "next": "__CHECK_IF_UPDATED__",
        "type": "table-update",
        "columns": [
          "redirect_url"
        ],
        "filters": {
          "link": "$and",
          "conditions": [
            {
              "field": "setting_key",
              "value": "redirect_url",
              "operator": "$eq"
            }
          ]
        },
        "tableName": "site_settings",
        "returnData": true,
        "updateMode": "by-filters",
        "__wwdescription": "تحديث قيمة رابط التوجيه في جدول site_settings"
      },
      "__CHECK_IF_UPDATED__": {
        "id": "__CHECK_IF_UPDATED__",
        "name": "Check If Setting Row Existed",
        "next": "__RETURN_SAVED_URL__",
        "type": "if",
        "value": {
          "code": "const updated = context.workflow['__UPDATE_SETTING__']?.result;\nreturn !Array.isArray(updated) || updated.length === 0;",
          "__wwtype": "js"
        },
        "branches": [
          {
            "id": "__INSERT_SETTING__",
            "value": true
          },
          {
            "id": null,
            "value": false
          }
        ],
        "__wwdescription": "إذا لم يكن الصف موجوداً مسبقاً، يتم إدراجه"
      },
      "__RETURN_SAVED_URL__": {
        "id": "__RETURN_SAVED_URL__",
        "body": {
          "code": "const raw = String(context.parameters['redirect_url'] || '').trim();\nconst normalized = !raw ? '' : (/^https?:\\/\\//i.test(raw) || raw.startsWith('/') ? raw : 'https://' + raw);\nreturn { ok: true, redirect_url: normalized };",
          "__wwtype": "js"
        },
        "name": "Return Saved Redirect URL",
        "next": null,
        "type": "return-response",
        "status": 200,
        "headers": {},
        "__wwdescription": "إرجاع الرابط المحفوظ بعد تنسيقه"
      }
    },
    "firstAction": "__UPDATE_SETTING__",
    "firstErrorAction": null,
    "meta": {
      "path": "/api/save-redirect-url",
      "method": "POST",
      "security": {
        "accessRule": "public"
      }
    },
    "trigger": "ww-api"
  },
